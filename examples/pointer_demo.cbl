// McBL# v2.0 — Pointer Demo (>> ... << syntax)

inc(pointer_demo);

    #umur = 21
    $array murid = {jaka, gerrard, dafa, zaki}

    // Pointer syntax — runtime akan resolve
    #ptr_val = umur
    pr("pointer value: " + ptr_val)

    // Demonstrasi operasi pointer lewat variable
    #compute = 10 + 20
    pr("compute = " + compute)

    // Akses array
    pr("murid[0] = " + murid[0])
    pr("murid[1] = " + murid[1])

endinc;
